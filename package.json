    "@ionic/react": "^8.8.19",
    "@ionic/react-router": "^8.8.19",
    "ionicons": "^8.1.0",
    "jsqr": "^1.4.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^5.3.4",
